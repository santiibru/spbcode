# --- Build (públicas, terminan en el HTML) ---
# URL pública sin barra final: se usa en canonical, hreflang, sitemap y JSON-LD
VITE_SITE_URL=https://spbcode.com
# Email visible en la sección de contacto
VITE_CONTACT_EMAIL=ciao@spbcode.com

# --- Servidor (privadas, nunca en el repo) ---
PORT=3000
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ciao@spbcode.com
SMTP_PASS=
# Remitente (debe ser una casilla del dominio autenticada en el SMTP)
MAIL_FROM="spbcode <ciao@spbcode.com>"
# Dónde llegan los mensajes del formulario
MAIL_TO=ciao@spbcode.com
